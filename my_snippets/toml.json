{
  "Ruff config for DL/ML projects": {
    "prefix": "pyrufflint",
    "body": [
      "[tool.ruff]",
      "line-length = ${1:100}",
      "target-version = \"${2:py311}\"",
      "",
      "[tool.ruff.lint]",
      "select = [",
      "  \"E\", \"W\", \"F\",  # baseline: pycodestyle + pyflakes",
      "  \"I\",             # isort",
      "  \"B\",             # bugbear",
      "  \"UP\",            # pyupgrade",
      "  \"SIM\",           # simplify",
      "  \"N\",             # naming",
      "  \"RUF\",           # ruff-specific",
      "]",
      "ignore = [",
      "  \"E501\",  # line length — DL has long tensor ops",
      "  \"F841\",  # unused locals — research idiom: x = layer(x); x = norm(x)",
      "  \"E731\",  # lambda assigns — activation funcs",
      "  \"B008\",  # mutable defaults — common in nn.Module",
      "  \"E741\",  # ambiguous var name (l, I, O) — math notation",
      "  \"N803\",  # arg names lowercase — tensors X, Y conventional",
      "  \"N806\",  # var names lowercase — same reason",
      "]",
      "",
      "[tool.ruff.lint.per-file-ignores]",
      "\"__init__.py\" = [\"F401\"]               # re-exports",
      "\"notebooks/*\" = [\"E402\", \"F401\", \"F811\"]  # nb cells reorder/redefine",
      "\"tests/*\"     = [\"F841\", \"B011\"]         # test fixtures",
      "$0"
    ],
    "description": "Ruff config tuned for PyTorch/DL — drop into pyproject.toml"
  },
  "Ruff format settings": {
    "prefix": "pyruffmt",
    "body": [
      "[tool.ruff.format]",
      "quote-style = \"${1|double,single|}\"",
      "indent-style = \"space\"",
      "skip-magic-trailing-comma = false",
      "line-ending = \"auto\"",
      "$0"
    ],
    "description": "Ruff formatter config"
  },
  "Basedpyright config (DL-tuned)": {
    "prefix": "pypyright",
    "body": [
      "[tool.basedpyright]",
      "typeCheckingMode = \"${1|off,basic,standard,strict|}\"",
      "",
      "# Keep — real bugs",
      "reportMissingImports = \"error\"",
      "reportUndefinedVariable = \"error\"",
      "",
      "# Optional[Tensor] family — forward() returns can be None",
      "reportOptionalMemberAccess = \"none\"",
      "reportOptionalSubscript = \"none\"",
      "reportOptionalIterable = \"none\"",
      "reportOptionalCall = \"none\"",
      "reportOptionalOperand = \"none\"",
      "reportOptionalContextManager = \"none\"",
      "",
      "# Tensor[...] indexing — torch stubs disagree with pyright",
      "reportIndexIssue = \"none\"",
      "reportOperatorIssue = \"none\"",
      "reportArgumentType = \"none\"",
      "reportCallIssue = \"none\"",
      "reportPossiblyUnbound = \"none\"",
      "reportGeneralTypeIssues = \"none\"",
      "",
      "# Research code noise",
      "reportAttributeAccessIssue = \"none\"",
      "reportAny = \"none\"",
      "reportUnknownMemberType = \"none\"",
      "reportUnknownVariableType = \"none\"",
      "reportUnknownArgumentType = \"none\"",
      "$0"
    ],
    "description": "Basedpyright config — mirrors nvim DL-tuned settings"
  }
}
